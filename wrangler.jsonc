{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kmaddireddy",
  "compatibility_date": "2026-10-01",
  // Static site: Cloudflare serves the built files in ./dist. No server code.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Attaches your Cloudflare-registered domain to this site on deploy.
  "routes": [
    { "pattern": "kmaddireddy.com", "custom_domain": true },
    { "pattern": "www.kmaddireddy.com", "custom_domain": true }
  ]
}
