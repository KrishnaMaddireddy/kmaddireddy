---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/articles';
interface Props { articles: CollectionEntry<'articles'>[]; }
const { articles } = Astro.props;
---
<ol class="article-list">
  {articles.map((a) => (
    <li>
      <h3><a class="mark-link" href={`/articles/${a.id}/`}>{a.data.title}</a>{a.data.draft && <span class="draft"> (draft)</span>}</h3>
      <p>{a.data.description}</p>
      <p class="meta"><time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time>, {readingTime(a.body)} min read</p>
    </li>
  ))}
</ol>

<style>
  .article-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; }
  h3 { margin: 0 0 0.25rem; font-size: var(--step-1); font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
  p { margin: 0; font-family: var(--serif); font-size: 1.0625rem; }
  p.meta { font-family: var(--sans); margin-top: 0.3rem; font-size: var(--step--1); }
  .draft { color: var(--muted); font-weight: 400; }
</style>
