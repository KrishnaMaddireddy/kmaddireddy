---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  const tags = [...new Set(articles.flatMap((a) => a.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { articles: articles.filter((a) => a.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { articles } = Astro.props;
---
<Base title={`Articles tagged ${tag}`}>
  <div class="page">
    <p><a class="mark-link" href="/articles/">All articles</a></p>
    <h1>Tagged “{tag}”</h1>
    <ArticleList articles={articles} />
  </div>
</Base>
<style>
  .page { max-width: var(--measure); padding: 2rem 0 3rem; }
  h1 { font-size: var(--step-3); font-weight: 750; font-stretch: 80%; letter-spacing: -0.02em; margin: 0.5rem 0 2rem; }
</style>
