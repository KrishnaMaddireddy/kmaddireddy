---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div style="padding: 4rem 0; max-width: var(--measure)">
    <h1 style="font-size: var(--step-3); font-stretch: 80%; margin: 0 0 1rem">This page doesn't exist</h1>
    <p>The link may be old or mistyped. Try the <a href="/">home page</a> or the <a href="/articles/">list of articles</a>.</p>
  </div>
</Base>
